  "iniFiles": [
   {
    "path": "/home/abhishek/fpga/lib/python3.8/site-packages/qiskit_aer/backends/qec_fpga_files/shor_link.cfg",
    "content": "# ============================================================================\n#  shor_link.cfg  —  v++ link config for shor_qec_kernel\n#  ---------------------------------------------------------------------------\n#  The Shor QEC kernel is AXI-Lite only: no HBM pseudo-channels, no\n#  pointer arguments, nothing to map to a memory bank. That is why this\n#  file is intentionally minimal and does NOT look like v05_link.cfg\n#  (which has 17 `sp=` lines for its 16 HBM banks + gate buffer).\n#\n#  We just declare:\n#    - one compute unit of shor_qec_kernel\n#    - the clock\n#    - a nominal SLR assignment to keep it co-located with (or adjacent\n#      to) v05's quantum_simulator_kernel when they eventually share an\n#      xclbin; for a standalone build any SLR is fine.\n# ============================================================================\n\n[connectivity]\nnk=shor_qec_kernel:1:shor_qec_kernel_1\n\n# Place the CU on SLR0 by default. Change to SLR1 or SLR2 if you later\n# combine this with v05's kernel and want to leave its SLR uncluttered.\nslr=shor_qec_kernel_1:SLR0\n\n[clock]\nfreqHz=300000000:shor_qec_kernel_1.ap_clk\n\n[vivado]\nprop=run.impl_1.STEPS.PHYS_OPT_DESIGN.IS_ENABLED=true\nprop=run.impl_1.STEPS.PHYS_OPT_DESIGN.ARGS.DIRECTIVE=Explore\n"
   }
  ],
  "cwd": "/home/abhishek/fpga/lib/python3.8/site-packages/qiskit_aer/backends/qec_fpga_files"
 }
}
</ENTRY>
